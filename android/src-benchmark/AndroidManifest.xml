<!--
 The `benchmark` build type's only difference from `release`, and it exists for L3.

 Macrobenchmark drives a build that is NOT debuggable — a debuggable app is a different
 program, with the interpreter and without the optimisations, and timing it answers a
 question nobody asked. `profileable` is what lets the shell read a trace out of such a
 build. See docs/maint/BENCHMARKS.md §11.
 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
  <application>
    <profileable android:shell="true" tools:targetApi="29"/>
  </application>
</manifest>
