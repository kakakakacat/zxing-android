# SUPERSEDED for the backend comparison. Taken before the spike pinned CameraX's
# aspect ratio, so CameraX here is answering 1920x1440 while Camera1 negotiates
# 1920x1080 -- 38% more pixels on one side of a one-variable comparison. Section 1
# of the decision record uses the later, pinned runs. This file is kept because
# section 3's default-vs-limiter pairs were both measured under these conditions and
# are still a fair comparison with each other.
#
# Phase 6 spike: CameraX's camera-validator retry, on an AVD that has no front camera.
#
# Emulator timings are inadmissible as a result (BENCHMARKS.md §10.7). This file is kept
# for the *ratio* and for the logcat extract below, which name the cause: CameraX checks
# that both lens facings exist and retries initialisation for ~5 s when one is missing.
# AVD zxing_api36 is configured hw.camera.front=none, and 'dumpsys media.camera' on it
# reports 'Number of camera devices: 1'.

## default (no limiter)
device: sdk_gphone64_arm64, sdk 36
fingerprint: google/sdk_gphone64_arm64/emu64a:16/BE2A.250530.026.F3/13894323:userdebug/dev-keys
package: io.github.kakakakacat.zxing.spike.camerax, runs: 3

run 1: backend=camerax processToFirstFrameMs=5987 createToFirstFrameMs=5979 openToFirstFrameMs=5975 frame=1280x960 rowStride=1280 pixelStride=1 decoder=backend=zxing-cpp;abi=arm64-v8a;neon=1;zxingcpp=3.1.1
        backend=camerax decodeMs=2 region=800x600 found=true
run 2: backend=camerax processToFirstFrameMs=5866 createToFirstFrameMs=5846 openToFirstFrameMs=5843 frame=1280x960 rowStride=1280 pixelStride=1 decoder=backend=zxing-cpp;abi=arm64-v8a;neon=1;zxingcpp=3.1.1
        backend=camerax decodeMs=9 region=800x600 found=true
run 3: backend=camerax processToFirstFrameMs=6057 createToFirstFrameMs=6042 openToFirstFrameMs=6037 frame=1280x960 rowStride=1280 pixelStride=1 decoder=backend=zxing-cpp;abi=arm64-v8a;neon=1;zxingcpp=3.1.1
        backend=camerax decodeMs=2 region=800x600 found=true

